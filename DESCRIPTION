    Matrix,
    msigdbr,
    parallel,
    pbapply,
    RColorBrewer,
    rmarkdown,
    stats,
    stringr,
    tidyr,
    tools,
    utils
Suggests:
    AnnotationDbi,
    arrow,
    biomaRt,
    msigdbdf,
    org.Hs.eg.db,
    org.Mm.eg.db,
    org.Rn.eg.db
Additional_repositories: https://igordot.r-universe.dev
biocViews: Proteomics, MassSpectrometry
